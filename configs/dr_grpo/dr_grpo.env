# Dr.GRPO -- arXiv 2503.20783. Config per verl docs/algo/grpo.md:53-62.
# Removes TWO biases: group-std (difficulty) and per-sequence length averaging.
ALGORITHM=DrGRPO
ADV_ESTIMATOR=grpo
NORM_ADV_BY_STD=False                 # algorithm.norm_adv_by_std_in_grpo
LOSS_AGG_MODE=seq-mean-token-sum-norm # turns off seq-dim averaging
LOSS_SCALE_FACTOR=4096                # constant divisor; keep == max_response_length
CLIP_RATIO_LOW=0.2
CLIP_RATIO_HIGH=0.2
USE_KL_LOSS=False                     # docs: set False for DrGRPO
KL_LOSS_COEF=0.0
FILTER_GROUPS=False
