# GSPO -- arXiv 2507.18071. Implemented natively: core_algos.py:1546 compute_policy_loss_gspo
ALGORITHM=GSPO
ADV_ESTIMATOR=grpo
POLICY_LOSS_MODE=gspo   # -> actor.policy_loss.loss_mode（不是 policy_loss_mode）
LOSS_AGG_MODE=seq-mean-token-mean     # recommended in the implementation docstring
CLIP_RATIO_LOW=0.2
CLIP_RATIO_HIGH=0.2
USE_KL_LOSS=True
KL_LOSS_COEF=0.001
FILTER_GROUPS=False
# PREREQUISITE (from R0): ppo_mini_batch_size MUST be < train_batch_size, else the
# importance ratio is identically 1 and every ratio/clip comparison is vacuous.
