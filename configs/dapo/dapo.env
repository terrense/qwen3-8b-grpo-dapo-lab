# DAPO -- defaults from verl-recipe/dapo/run_dapo_qwen2.5_32b.sh, scaled to this node.
ALGORITHM=DAPO
ADV_ESTIMATOR=grpo
NORM_ADV_BY_STD=True
LOSS_AGG_MODE=token-mean              # token-level PG loss
CLIP_RATIO_LOW=0.2
CLIP_RATIO_HIGH=0.28                  # clip-higher
CLIP_RATIO_C=10.0
FILTER_GROUPS=True                    # dynamic sampling
FILTER_GROUPS_METRIC=acc
MAX_NUM_GEN_BATCHES=10
OVERLONG_BUFFER_ENABLE=True           # overlong reward shaping
OVERLONG_BUFFER_LEN=4096
OVERLONG_PENALTY_FACTOR=1.0
USE_KL_LOSS=False                     # DAPO removes the KL term entirely
KL_LOSS_COEF=0.0
